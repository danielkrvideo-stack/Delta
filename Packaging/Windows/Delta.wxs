<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Delta"
           Manufacturer="Delta Browser"
           Version="$(var.Version)"
           UpgradeCode="86721826-9D8F-45B7-98BD-674642F2E0B8"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Delta is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Programs\Delta" />
    </StandardDirectory>
    <Feature Id="Main" Title="Delta" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="HtmlFileAssociation" />
    </Feature>
  </Package>
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Delta" />
    </StandardDirectory>
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="DeltaShortcut" Name="Delta" Target="[INSTALLFOLDER]Delta.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Delta" Name="Installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="HtmlFileAssociation" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Classes\.html" Type="string"
                     Value="Delta.HTML" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.htm" Type="string"
                     Value="Delta.HTML" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.xhtml" Type="string"
                     Value="Delta.HTML" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Delta.HTML" Type="string"
                     Value="HTML Document" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Delta.HTML\DefaultIcon" Type="string"
                     Value="[INSTALLFOLDER]Delta.exe,0" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Delta.HTML\shell\open\command" Type="string"
                     Value="&quot;[INSTALLFOLDER]Delta.exe&quot; &quot;%1&quot;" />
    </Component>
  </Fragment>
</Wix>
